# Copy to .env and fill in. NEVER commit .env, *.session files, or API keys.

# --- Database (matches docker-compose.yml) ---
NEWSROOM_DATABASE_URL=postgresql+psycopg://newsroom:newsroom@localhost:5432/newsroom

# --- OpenAI (embeddings + LLM; used from stage 1b onward, not in 1a) ---
OPENAI_API_KEY=
# --- Telegram publishing (Bot API) — reused from the previous project ---
# The bot must be an admin of the target channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_CHAT_ID=-1003750698363
TELEGRAM_ADMIN_CHAT_ID=404237030

# --- Telegram collecting (Telethon / MTProto) — dedicated NON-personal account ---
# Leave COLLECTOR_TELEGRAM_ENABLED=false until credentials exist. The session file
# is a full-access secret: store it outside the repo and never commit it.
COLLECTOR_TELEGRAM_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./secrets/newsroom.session

# --- Runtime ---
NEWSROOM_LOG_LEVEL=INFO
# Verification pass over collected items (stage 1b): filter -> classify -> cluster
# -> risk gate. Needs OPENAI_API_KEY (LLM classifier + embeddings). Nothing is
# published either way. Off by default.
VERIFY_ENABLED=false
# Shared fact base (stage 1c): extract each source's facts for publishable events
# and merge them into one viewpoint (confirmed across sources, number divergence)
# on events.fact_base. Needs OPENAI_API_KEY. Runs before fact-check/editorial.
FACTBASE_ENABLED=false
# Fact-checking (stage 1c): extract atomic claims from publishable events, gather
# corpus evidence and judge a verdict. Needs OPENAI_API_KEY. Runs before editorial;
# nothing is published. Off by default.
FACTCHECK_ENABLED=false
# Story updates (stage 1c): classify how each new event moves its story
# (new_fact/refutation/consequence -> post; else update the summary) and maintain
# current_summary + story_versions. Needs OPENAI_API_KEY. Runs before editorial.
STORY_UPDATES_ENABLED=false
# Editorial drafting (stage 1c): generate + critic -> draft publications for
# publishable events. Needs OPENAI_API_KEY. Drafts only, nothing is published.
EDITORIAL_ENABLED=false
# Master publish switch. Even when true, nothing is posted until the editorial
# pipeline (stages 1b-1c) produces posts. false = hard-off (stop button).
PUBLISH_ENABLED=true
