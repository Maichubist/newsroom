# Copy to .env and fill in. NEVER commit .env, *.session files, or API keys.

# --- Database (matches docker-compose.yml) ---
NEWSROOM_DATABASE_URL=postgresql+psycopg://newsroom:newsroom@localhost:5432/newsroom

# --- OpenAI (embeddings + LLM; used from stage 1b onward, not in 1a) ---
OPENAI_API_KEY=
# --- Telegram publishing (Bot API) — reused from the previous project ---
# The bot must be an admin of the target channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_CHAT_ID=-1003750698363
TELEGRAM_ADMIN_CHAT_ID=404237030
# Shadow mode (architecture §2): publish to a CLOSED test channel for 1-2 weeks
# before going live. When on, posts route to TELEGRAM_SHADOW_CHANNEL_CHAT_ID
# instead of the real channel. Exit criteria are checked from config/shadow.yaml.
SHADOW_MODE=false
TELEGRAM_SHADOW_CHANNEL_CHAT_ID=

# --- Telegram collecting (Telethon / MTProto) — dedicated NON-personal account ---
# Leave COLLECTOR_TELEGRAM_ENABLED=false until credentials exist. The session file
# is a full-access secret: store it outside the repo and never commit it.
COLLECTOR_TELEGRAM_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./secrets/newsroom.session
# A channel seen for the FIRST time is seeded with only its most recent
# TELEGRAM_SEED_LIMIT posts (not its whole history — a busy aggregator has tens of
# thousands). Later ticks catch up on new posts, at most TELEGRAM_MAX_BACKFILL per tick.
TELEGRAM_SEED_LIMIT=30
TELEGRAM_MAX_BACKFILL=500

# Collection window: every source (RSS + Telegram) ingests only items published
# within this many hours — we collect news, not an archive. 0 disables the window.
COLLECT_MAX_AGE_HOURS=24

# --- Runtime ---
NEWSROOM_LOG_LEVEL=INFO
# Verification pass over collected items (stage 1b): filter -> classify -> cluster
# -> risk gate. Needs OPENAI_API_KEY (LLM classifier + embeddings). Nothing is
# published either way. Off by default.
VERIFY_ENABLED=false
# Shared fact base (stage 1c): extract each source's facts for publishable events
# and merge them into one viewpoint (confirmed across sources, number divergence)
# on events.fact_base. Needs OPENAI_API_KEY. Runs before fact-check/editorial.
FACTBASE_ENABLED=false
# Fact-checking (stage 1c): extract atomic claims from publishable events, gather
# corpus evidence and judge a verdict. Needs OPENAI_API_KEY. Runs before editorial;
# nothing is published. Off by default.
FACTCHECK_ENABLED=false
# Fact-check only high/critical-risk events (war, defense, security, politics,
# accusations…) and skip low-risk topics (economy, tech, sport, culture) that need
# no deep verdicts. Cuts the priciest LLM step further. Unknown-risk events are still
# checked (conservative). Off = check all publishable events (charter default).
FACTCHECK_HIGH_ONLY=false
# Media pipeline (stage 1г): download filter-passed media + pHash (needs Pillow:
# pip install "newsroom[media]"), check for recycled images (DB-only), and moderate
# images against the charter media bans (needs OPENAI_API_KEY, vision). Media only
# attaches to a post once both the reuse check and moderation pass.
# og:image resolution (§13): for filter-passed items whose RSS carried no media
# (e.g. Економічна Правда), fetch the article page and record its og:image as an
# image asset, so it flows through download/reuse/vision. HTTP only, no OPENAI_API_KEY.
# Runs before media download.
MEDIA_OGIMAGE_ENABLED=false
MEDIA_DOWNLOAD_ENABLED=false
MEDIA_STORE_DIR=./media
MEDIA_CHECK_ENABLED=false
MEDIA_MODERATION_ENABLED=false
# Story linking (stage 1c, architecture §7): attach each clustered event to a
# story by vector similarity (near-identical events share a story, so repeats
# become summary-only instead of duplicate posts, and story posts reply-chain).
# DB-only, no OPENAI_API_KEY. Runs before story updates and editorial.
STORIES_ENABLED=false
# Cosine threshold for linking an event to a story (cross-source dedup). Lower =
# merges more (calibrated ~0.62: dups ~0.65-0.70 merge, distinct same-theme ~0.55
# stay apart). Leave unset to use the calibrated default.
STORY_THRESHOLD=0.62
# Story updates (stage 1c): classify how each new event moves its story
# (new_fact/refutation/consequence -> post; else update the summary) and maintain
# current_summary + story_versions. Needs OPENAI_API_KEY. Runs before editorial.
STORY_UPDATES_ENABLED=false
# Significance gate (stage 1c, T1): score each event's significance from stable
# signals (rubric, UA-relevance, corroboration, story momentum) and skip niche/minor
# news before editorial. DB-only, no OPENAI_API_KEY. Threshold in config/significance.yaml
# ("raise the bar" = raise `threshold`). Runs before editorial.
SIGNIFICANCE_ENABLED=false
# LLM batch dedup (stage 1c): group same-story events (same news, different source/
# wording) the embedding threshold misses; non-canonical duplicates are marked and not
# posted. Needs OPENAI_API_KEY. Runs before curation.
DEDUP_ENABLED=false
# Editorial curation (§: publish by merit, not by rate): an LLM editor ranks the
# recent window of significant events and marks each publish/hold; critical+official
# and refutations are must-publish. Only publish-marked events are drafted — the post
# count follows the news, no fixed cadence. Needs OPENAI_API_KEY. Runs before editorial.
CURATION_ENABLED=false
# Editorial drafting (stage 1c): generate + critic -> draft publications for
# publishable events (curation-approved when CURATION_ENABLED). Needs OPENAI_API_KEY.
EDITORIAL_ENABLED=false
# Attacks digest (§): reserve shelling/strike events and post one combined digest per
# window ("Обстріли за ніч/день", config/digest.yaml) instead of individual posts.
# DB + Telegram only, no OPENAI_API_KEY. Needs publishing enabled.
DIGEST_ENABLED=false
# Source reputation (stage 1c): credit first/copy/confirmed/refuted from settled
# events. DB-only, no OPENAI_API_KEY.
REPUTATION_ENABLED=false
# Post-publication monitoring (stage 1c/1г): draft a correction when a source
# retracts an item behind a published post. DB-only. Corrections stay drafts.
MONITORING_ENABLED=false
# Metrics (stage 1г): snapshot post views/reactions/forwards and channel
# subscribers. Reads via the collector's Telethon session, so it needs
# COLLECTOR_TELEGRAM_ENABLED and the reading account subscribed to the channel.
METRICS_ENABLED=false
# Demand intelligence (docs/demand-intelligence.md): snapshot engagement
# (views/reactions/forwards) of monitored source channels' recent posts + their
# subscriber counts, so demand data accumulates for later theme analysis. Reads via
# the collector's Telethon session (needs COLLECTOR_TELEGRAM_ENABLED). Collection only.
DEMAND_METRICS_ENABLED=false
# Master publish switch. Even when true, nothing is posted until the editorial
# pipeline (stages 1b-1c) produces posts. false = hard-off (stop button).
PUBLISH_ENABLED=true
